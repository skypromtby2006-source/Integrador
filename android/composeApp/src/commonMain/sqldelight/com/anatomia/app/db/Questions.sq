CREATE TABLE questions (
    id            INTEGER NOT NULL PRIMARY KEY,
    topic         TEXT    NOT NULL,
    organ_id      TEXT    NOT NULL,
    stem          TEXT    NOT NULL,
    explanation   TEXT    NOT NULL DEFAULT '',
    options       TEXT    NOT NULL,
    correct_index INTEGER NOT NULL,
    difficulty    INTEGER NOT NULL DEFAULT 1
);

upsertQuestion:
INSERT OR REPLACE INTO questions
(id, topic, organ_id, stem, explanation, options, correct_index, difficulty)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getAllQuestions:
SELECT * FROM questions;

getByOrgan:
SELECT * FROM questions WHERE organ_id = ?;

getByDifficulty:
SELECT * FROM questions WHERE difficulty = ?;

clearQuestions:
DELETE FROM questions;

countByOrgan:
SELECT COUNT(*) FROM questions WHERE organ_id = ?;
